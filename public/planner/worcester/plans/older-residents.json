{
  "question": "Worcester is ageing fast. Can older residents reach a GP, food, green space and company without a car, and where is the 65+ population growing?",
  "steps": [
    {
      "tool": "travel",
      "args": {
        "to": "meet:*"
      },
      "as": "meet"
    },
    {
      "tool": "travel",
      "args": {
        "to": "green:*"
      },
      "as": "green"
    },
    {
      "tool": "travel",
      "args": {
        "to": [
          "food:smallShop",
          "food:supermarket",
          "shop"
        ]
      },
      "as": "food"
    },
    {
      "tool": "travel",
      "args": {
        "to": "gp",
        "mode": "busOrWalk"
      },
      "as": "gp"
    },
    {
      "tool": "meets",
      "args": {
        "checks": [
          {
            "values": "$meet",
            "max": 10
          },
          {
            "values": "$green",
            "max": 5
          },
          {
            "values": "$food",
            "max": 10
          },
          {
            "values": "$gp",
            "max": 15
          }
        ]
      },
      "as": "goodDayHome"
    },
    {
      "tool": "travel",
      "args": {
        "to": "bus"
      },
      "as": "bus"
    },
    {
      "tool": "summarise",
      "args": {
        "values": "$goodDayHome",
        "groupBy": "town",
        "weight": "over65"
      },
      "as": "goodDayOver65"
    },
    {
      "tool": "summarise",
      "args": {
        "values": "$goodDayHome",
        "groupBy": "town"
      },
      "as": "goodDayAll"
    },
    {
      "tool": "summarise",
      "args": {
        "values": "$gp",
        "groupBy": "town",
        "weight": "over65"
      },
      "as": "gpMinutesOver65"
    },
    {
      "tool": "summarise",
      "args": {
        "values": "$gp",
        "groupBy": "town"
      },
      "as": "gpMinutesAll"
    },
    {
      "tool": "summarise",
      "args": {
        "values": "$goodDayHome",
        "groupBy": "ward",
        "weight": "over65"
      },
      "as": "goodDayOver65ByWard"
    },
    {
      "tool": "attribute",
      "args": {
        "name": "over65"
      },
      "as": "over65"
    },
    {
      "tool": "attribute",
      "args": {
        "name": "over65Change"
      },
      "as": "over65Change"
    },
    {
      "tool": "attribute",
      "args": {
        "name": "livingAlone66"
      },
      "as": "livingAlone66"
    },
    {
      "tool": "summarise",
      "args": {
        "values": "$goodDayHome",
        "groupBy": "area"
      },
      "as": "goodDay"
    },
    {
      "tool": "rank",
      "args": {
        "of": "$over65Change",
        "top": 8,
        "namePrefix": "Worcester "
      },
      "as": "fastestAgeing"
    }
  ],
  "show": [
    "goodDayOver65",
    "goodDayAll",
    "gpMinutesOver65",
    "gpMinutesAll",
    "goodDayOver65ByWard",
    "fastestAgeing"
  ]
}