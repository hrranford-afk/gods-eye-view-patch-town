{
  "question": "What does the full map of Worcester show? Which figures go together, and which neighbourhoods are far better or worse than their deprivation would predict?",
  "steps": [
    {
      "tool": "travel",
      "args": {
        "to": "meet:*"
      },
      "as": "meet"
    },
    {
      "tool": "travel",
      "args": {
        "to": "green:*"
      },
      "as": "green"
    },
    {
      "tool": "travel",
      "args": {
        "to": [
          "food:smallShop",
          "food:supermarket",
          "shop"
        ]
      },
      "as": "food"
    },
    {
      "tool": "travel",
      "args": {
        "to": "gp",
        "mode": "busOrWalk"
      },
      "as": "gp"
    },
    {
      "tool": "meets",
      "args": {
        "checks": [
          {
            "values": "$meet",
            "max": 10
          },
          {
            "values": "$green",
            "max": 5
          },
          {
            "values": "$food",
            "max": 10
          },
          {
            "values": "$gp",
            "max": 15
          }
        ]
      },
      "as": "goodDayHome"
    },
    {
      "tool": "summarise",
      "args": {
        "values": "$goodDayHome",
        "groupBy": "area"
      },
      "as": "goodDay"
    },
    {
      "tool": "summarise",
      "args": {
        "values": "$gp",
        "groupBy": "area"
      },
      "as": "gpMinutes"
    },
    {
      "tool": "summarise",
      "args": {
        "values": "$green",
        "groupBy": "area"
      },
      "as": "greenMinutes"
    },
    {
      "tool": "summarise",
      "args": {
        "values": "$meet",
        "groupBy": "area"
      },
      "as": "meetMinutes"
    },
    {
      "tool": "count",
      "args": {
        "kind": "food:takeaway"
      },
      "as": "takeawaysPer1000"
    },
    {
      "tool": "count",
      "args": {
        "kind": "food:smallShop"
      },
      "as": "cornerShopsPer1000"
    },
    {
      "tool": "count",
      "args": {
        "kind": "meet:pub"
      },
      "as": "pubsPer1000"
    },
    {
      "tool": "count",
      "args": {
        "kind": [
          "collision:serious",
          "collision:fatal"
        ]
      },
      "as": "seriousCrashesPer1000"
    },
    {
      "tool": "survey",
      "args": {
        "namePrefix": "Worcester ",
        "fields": [
          "imdScore",
          "incomeAfterHousing",
          "badHealth",
          "over65",
          "livingAlone66",
          "noCar",
          "crimePer1000",
          "violencePer1000",
          "antisocialPer1000",
          "medianPrice",
          "priceChange",
          "jobsPerResident",
          "newHomesShare",
          "carCommute2021",
          "cycleCommute2021",
          "walkCommute2021",
          "floodZone3Share"
        ],
        "extra": {
          "goodDay": "$goodDay",
          "gpMinutes": "$gpMinutes",
          "greenMinutes": "$greenMinutes",
          "meetMinutes": "$meetMinutes",
          "takeawaysPer1000": "$takeawaysPer1000",
          "cornerShopsPer1000": "$cornerShopsPer1000",
          "pubsPer1000": "$pubsPer1000",
          "seriousCrashesPer1000": "$seriousCrashesPer1000"
        },
        "surprisesFor": [
          "badHealth",
          "livingAlone66",
          "crimePer1000",
          "goodDay",
          "cycleCommute2021",
          "walkCommute2021",
          "medianPrice",
          "noCar",
          "jobsPerResident"
        ],
        "top": 15
      },
      "as": "survey"
    }
  ],
  "show": [
    "survey"
  ]
}