{
  "question": "Where does migration fit in Worcester's whole picture? Counted per neighbourhood from the census (born abroad, recent arrivals, English), beside health, money, crime, services and housing; plus Home Office asylum support for the council as a whole.",
  "notes": "Census counts everyone resident, whatever their status, and records no legal status. Asylum support exists only per council (asylum.json). Correlations between neighbourhoods are not facts about individuals.",
  "steps": [
    {
      "tool": "travel",
      "args": {
        "to": "meet:*"
      },
      "as": "meet"
    },
    {
      "tool": "travel",
      "args": {
        "to": "green:*"
      },
      "as": "green"
    },
    {
      "tool": "travel",
      "args": {
        "to": [
          "food:smallShop",
          "food:supermarket",
          "shop"
        ]
      },
      "as": "food"
    },
    {
      "tool": "travel",
      "args": {
        "to": "gp",
        "mode": "busOrWalk"
      },
      "as": "gp"
    },
    {
      "tool": "meets",
      "args": {
        "checks": [
          {
            "values": "$meet",
            "max": 10
          },
          {
            "values": "$green",
            "max": 5
          },
          {
            "values": "$food",
            "max": 10
          },
          {
            "values": "$gp",
            "max": 15
          }
        ]
      },
      "as": "goodDayHome"
    },
    {
      "tool": "summarise",
      "args": {
        "values": "$goodDayHome",
        "groupBy": "area"
      },
      "as": "goodDay"
    },
    {
      "tool": "summarise",
      "args": {
        "values": "$gp",
        "groupBy": "area"
      },
      "as": "gpMinutes"
    },
    {
      "tool": "summarise",
      "args": {
        "values": "$green",
        "groupBy": "area"
      },
      "as": "greenMinutes"
    },
    {
      "tool": "summarise",
      "args": {
        "values": "$meet",
        "groupBy": "area"
      },
      "as": "meetMinutes"
    },
    {
      "tool": "count",
      "args": {
        "kind": "food:takeaway",
        "per": "dayPopulation"
      },
      "as": "takeawaysPerDay"
    },
    {
      "tool": "count",
      "args": {
        "kind": "food:smallShop",
        "per": "dayPopulation"
      },
      "as": "cornerShopsPerDay"
    },
    {
      "tool": "count",
      "args": {
        "kind": "meet:pub",
        "per": "dayPopulation"
      },
      "as": "pubsPerDay"
    },
    {
      "tool": "count",
      "args": {
        "kind": [
          "collision:serious",
          "collision:fatal"
        ],
        "per": "dayPopulation"
      },
      "as": "seriousCrashesPerDay"
    },
    {
      "tool": "survey",
      "args": {
        "namePrefix": "Worcester ",
        "fields": [
          "imdScore",
          "incomeAfterHousing",
          "badHealth",
          "over65",
          "livingAlone66",
          "noCar",
          "medianPrice",
          "jobsPerResident",
          "newHomesShare",
          "carCommute2021",
          "walkCommute2021",
          "crimePer1000Day",
          "violencePer1000Day",
          "antisocialPer1000Day",
          "bornAbroad",
          "arrivedRecently",
          "littleEnglish"
        ],
        "extra": {
          "goodDay": "$goodDay",
          "gpMinutes": "$gpMinutes",
          "greenMinutes": "$greenMinutes",
          "meetMinutes": "$meetMinutes",
          "takeawaysPerDay": "$takeawaysPerDay",
          "cornerShopsPerDay": "$cornerShopsPerDay",
          "pubsPerDay": "$pubsPerDay"
        },
        "explainBy": "imdScore",
        "surprisesFor": [
          "bornAbroad",
          "arrivedRecently",
          "littleEnglish"
        ]
      },
      "as": "survey"
    },
    {
      "tool": "attribute",
      "args": {
        "name": "bornAbroad"
      },
      "as": "bornAbroad"
    },
    {
      "tool": "attribute",
      "args": {
        "name": "littleEnglish"
      },
      "as": "littleEnglish"
    },
    {
      "tool": "attribute",
      "args": {
        "name": "imdScore"
      },
      "as": "imdScore"
    },
    {
      "tool": "attribute",
      "args": {
        "name": "noCar"
      },
      "as": "noCar"
    },
    {
      "tool": "attribute",
      "args": {
        "name": "over65"
      },
      "as": "over65"
    },
    {
      "tool": "attribute",
      "args": {
        "name": "crimePer1000Day"
      },
      "as": "crimePer1000Day"
    },
    {
      "tool": "attribute",
      "args": {
        "name": "violencePer1000Day"
      },
      "as": "violencePer1000Day"
    },
    {
      "tool": "attribute",
      "args": {
        "name": "badHealth"
      },
      "as": "badHealth"
    },
    {
      "tool": "attribute",
      "args": {
        "name": "medianPrice"
      },
      "as": "medianPrice"
    },
    {
      "tool": "relate",
      "args": {
        "y": "$crimePer1000Day",
        "x": {
          "bornAbroad": "$bornAbroad"
        },
        "controls": {
          "imdScore": "$imdScore",
          "noCar": "$noCar"
        }
      },
      "as": "crimePer1000DayVsBornAbroad"
    },
    {
      "tool": "relate",
      "args": {
        "y": "$violencePer1000Day",
        "x": {
          "bornAbroad": "$bornAbroad"
        },
        "controls": {
          "imdScore": "$imdScore",
          "noCar": "$noCar"
        }
      },
      "as": "violencePer1000DayVsBornAbroad"
    },
    {
      "tool": "relate",
      "args": {
        "y": "$badHealth",
        "x": {
          "bornAbroad": "$bornAbroad"
        },
        "controls": {
          "imdScore": "$imdScore",
          "over65": "$over65"
        }
      },
      "as": "badHealthVsBornAbroad"
    },
    {
      "tool": "relate",
      "args": {
        "y": "$medianPrice",
        "x": {
          "bornAbroad": "$bornAbroad"
        },
        "controls": {
          "imdScore": "$imdScore"
        }
      },
      "as": "pricesVsBornAbroad"
    }
  ]
}