{
  "question": "{town} in one line per figure: the same measures for every town, as resident-weighted means with the lowest and highest neighbourhood.",
  "notes": "Only the council's own neighbourhoods ('{town} ' prefix). Health outcomes are per MSOA, child poverty per ward, air per 1 km. Growth by age is read from the council figures (population), not averaged: one new estate can grow thirtyfold from a tiny base.",
  "steps": [
    {
      "tool": "travel",
      "args": {
        "to": "meet:*"
      },
      "as": "meet"
    },
    {
      "tool": "travel",
      "args": {
        "to": "green:*"
      },
      "as": "green"
    },
    {
      "tool": "travel",
      "args": {
        "to": [
          "food:smallShop",
          "food:supermarket",
          "shop"
        ]
      },
      "as": "food"
    },
    {
      "tool": "travel",
      "args": {
        "to": "gp",
        "mode": "busOrWalk"
      },
      "as": "gp"
    },
    {
      "tool": "meets",
      "args": {
        "checks": [
          {
            "values": "$meet",
            "max": 10
          },
          {
            "values": "$green",
            "max": 5
          },
          {
            "values": "$food",
            "max": 10
          },
          {
            "values": "$gp",
            "max": 15
          }
        ]
      },
      "as": "goodDayHome"
    },
    {
      "tool": "summarise",
      "args": {
        "values": "$goodDayHome",
        "groupBy": "area"
      },
      "as": "goodDay"
    },
    {
      "tool": "summarise",
      "args": {
        "values": "$gp",
        "groupBy": "area"
      },
      "as": "gpMinutes"
    },
    {
      "tool": "summarise",
      "args": {
        "values": "$green",
        "groupBy": "area"
      },
      "as": "greenMinutes"
    },
    {
      "tool": "summarise",
      "args": {
        "values": "$food",
        "groupBy": "area"
      },
      "as": "foodMinutes"
    },
    {
      "tool": "profile",
      "args": {
        "namePrefix": "{town} ",
        "fields": [
          "imdScore",
          "incomeAfterHousing",
          "childPoverty",
          "claimantRate",
          "noQualifications",
          "degree",
          "lifeExpectancy",
          "healthyLifeExpectancy",
          "deathsUnder75",
          "selfHarmAdmissions",
          "alcoholAdmissions",
          "year6Obesity",
          "badHealth",
          "gp_depression",
          "no2",
          "pm25",
          "fuelPoverty",
          "overcrowded",
          "privateRent",
          "socialRent",
          "medianPrice",
          "noCar",
          "carCommute2021",
          "cycleCommute2021",
          "walkCommute2021",
          "cycleGoDutch",
          "workUnder5km",
          "over65",
          "livingAlone66",
          "carers",
          "disabled",
          "bornAbroad",
          "crimePer1000Day",
          "violencePer1000Day",
          "floodZone3Share",
          "gp_antidepressantsPer1000",
          "gp_opioidsPer1000",
          "ahah",
          "roadNoise55",
          "greenspaceAccessWithin300m",
          "natureReserveWithin1km",
          "charitiesPer1000",
          "foodbankWithin1km",
          "wardTurnout",
          "childcareProviders"
        ],
        "extra": {
          "goodDay": "$goodDay",
          "gpMinutes": "$gpMinutes",
          "greenMinutes": "$greenMinutes",
          "foodMinutes": "$foodMinutes"
        }
      },
      "as": "profile"
    },
    {
      "tool": "council",
      "as": "council"
    }
  ],
  "show": [
    "profile",
    "council"
  ]
}