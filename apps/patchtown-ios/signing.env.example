# Copy this file to signing.env (it is git-ignored) and fill in your own values.
# scripts/generate.sh reads it every time it makes the Xcode project.

# Your app's bundle id: reverse-DNS, unique to you, e.g. com.harrysmith.patchtown
PATCHTOWN_BUNDLE_ID=com.REPLACE_ME.patchtown

# Your Apple Developer team id: 10 letters/digits, from https://developer.apple.com/account (Membership details).
PATCHTOWN_TEAM_ID=

# Build number: must go up by one for every upload to TestFlight (1, 2, 3, ...).
PATCHTOWN_BUILD_NUMBER=1
